name: ci

on:
  push:
    branches: [dev]
  pull_request:

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

# Template only: remote CI has not been enabled. Local equivalents are recorded in M2 §9.
# The test database is a single-node replica set so MongoDB transactions work.
jobs:
  verify:
    runs-on: ubuntu-latest
    services:
      mongo-test:
        image: mongo:7.0
        ports:
          - "27018:27017"
        options: >-
          --replSet rsTest
          --health-cmd "mongosh --quiet --eval \"db.adminCommand('ping').ok\""
          --health-interval 5s
          --health-timeout 5s
          --health-retries 20
    env:
      MONGODB_URI: mongodb://127.0.0.1:27017/guihua_library
      TEST_MONGODB_URI: mongodb://127.0.0.1:27018/guihua_library_test
      ALLOWED_ORIGINS: http://127.0.0.1:5173,http://localhost:5173
    steps:
      - uses: actions/checkout@v4

      - uses: pnpm/action-setup@v4
        with:
          version: 11.5.2

      - uses: actions/setup-node@v4
        with:
          node-version: "22.22.1"
          cache: pnpm

      - name: Frozen install
        run: pnpm install --frozen-lockfile

      - name: Typecheck
        run: pnpm typecheck

      - name: Lint
        run: pnpm lint

      - name: Offline tests
        run: pnpm test

      - name: Build
        run: pnpm build

      - name: Initiate test replica set
        run: |
          for i in 1 2 3 4 5; do
            docker exec "$(docker ps -q --filter ancestor=mongo:7.0 | head -1)" \
              mongosh --quiet --eval 'try { rs.status().ok } catch (e) { rs.initiate({_id:"rsTest",members:[{_id:0,host:"127.0.0.1:27018"}]}).ok }' && break
            sleep 2
          done

      - name: Integration tests against MongoDB replica set
        run: pnpm test:integration

      - name: Install Chromium
        run: pnpm --filter @guihua/api exec playwright install --with-deps chromium

      - name: Browser smoke
        run: pnpm smoke
