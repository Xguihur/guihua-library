name: ci

on:
  push:
    branches: [dev]
  pull_request:

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  verify:
    runs-on: ubuntu-latest
    services:
      mongo-test:
        image: mongo:7.0
        ports:
          - "27018:27017"
        options: >-
          --health-cmd "mongosh --quiet --eval \"db.adminCommand('ping').ok\""
          --health-interval 5s
          --health-timeout 5s
          --health-retries 20
    env:
      MONGODB_URI: mongodb://127.0.0.1:27017/guihua_library
      TEST_MONGODB_URI: mongodb://127.0.0.1:27018/guihua_library_test
    steps:
      - uses: actions/checkout@v4

      - uses: pnpm/action-setup@v4
        with:
          version: 11.5.2

      - uses: actions/setup-node@v4
        with:
          node-version: "22.22.1"
          cache: pnpm

      - name: Frozen install
        run: pnpm install --frozen-lockfile

      - name: Typecheck
        run: pnpm typecheck

      - name: Lint
        run: pnpm lint

      - name: Offline tests
        run: pnpm test

      - name: Build
        run: pnpm build

      - name: Integration tests against MongoDB
        run: pnpm test:integration

      - name: Install Chromium
        run: pnpm --filter @guihua/api exec playwright install --with-deps chromium

      - name: Browser smoke
        run: pnpm smoke
