{
  "name": "@guihua/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "seed": "tsx src/seed/seed.ts",
    "db:migrate": "tsx src/scripts/migrate-m1-accounts.ts",
    "reset-test-db": "tsx src/scripts/reset-test-db.ts",
    "verify:isolation": "tsx scripts/verify-db-isolation.ts",
    "smoke": "tsx test/smoke/smoke.ts"
  },
  "dependencies": {
    "@guihua/contracts": "workspace:*",
    "@nestjs/common": "^11.0.6",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.6",
    "@nestjs/mongoose": "^11.0.1",
    "@nestjs/platform-express": "^11.0.6",
    "dotenv": "^16.4.7",
    "mongoose": "^8.9.5",
    "nodemailer": "^7.0.13",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.6",
    "@types/nodemailer": "^7.0.12",
    "@types/supertest": "^6.0.2",
    "playwright": "^1.49.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
