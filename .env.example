# Copy to .env for local development. Real secrets never belong in git.
# API loads this file from the repository root even when pnpm runs from apps/api.
NODE_ENV=development
# Decimal integer in 1-65535; the API binds only to 127.0.0.1.
PORT=3000
# Must be a mongodb:// URI with a host and database name.
MONGODB_URI=mongodb://127.0.0.1:27017/guihua_library

# Required only by db:test:reset, test:integration and smoke.
# There is no fallback to MONGODB_URI: tests fail loudly when this is missing.
TEST_MONGODB_URI=mongodb://127.0.0.1:27018/guihua_library_test

# dev (27017, rsDev) and test (27018, rsTest) are separate single-node replica
# sets; MongoDB transactions require a replica set and never a standalone server.
# The driver auto-detects the set; ?replicaSet=rsDev / rsTest may be added explicitly.

# Exact browser origins allowed to make same-origin JSON writes. No wildcards.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- M2c GitHub OAuth (optional) ---
# Without a non-empty client id AND secret, every GitHub entry returns a masked
# 503 while the rest of the app keeps working. No real credential belongs here.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The callback registered with the GitHub OAuth App is fixed per environment.
GITHUB_CALLBACK_URL=http://127.0.0.1:3000/api/oauth/github/callback
# These are the real github.com endpoints. Tests may override them to point at
# a clearly-labelled local *simulation* to exercise the real HTTP flow.
GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_USER_URL=https://api.github.com/user

# --- M2c SMTP / local mail capture (optional) ---
# Without a non-empty SMTP_HOST, verification-mail entries return a masked 503.
# `pnpm mail:up` starts a loopback-only Mailpit (SMTP 1025, HTTP API 8025) for dev/test.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@guihua.local
# TLS is OFF for the loopback-only Mailpit capture above. For production, use
# SMTP_SECURE=true with port 465 (implicit TLS), or keep SMTP_SECURE=false with
# port 587 and SMTP_REQUIRE_TLS=true (explicit STARTTLS). Never send credentials
# over an unencrypted connection; both flags default to false for local dev.
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
# Bounded SMTP connect/greeting/socket timeout in milliseconds.
MAIL_TIMEOUT_MS=5000
MAILPIT_API_URL=http://127.0.0.1:8025
# Site origin used to build fixed email-verification pages (token lives in the URL fragment).
WEB_BASE_URL=http://127.0.0.1:5173
