# Copy to .env for local development. Real secrets never belong in git.
# API loads this file from the repository root even when pnpm runs from apps/api.
NODE_ENV=development
# Decimal integer in 1-65535; the API binds only to 127.0.0.1.
PORT=3000
# Must be a mongodb:// URI with a host and database name.
MONGODB_URI=mongodb://127.0.0.1:27017/guihua_library

# Required only by db:test:reset, test:integration and smoke.
# There is no fallback to MONGODB_URI: tests fail loudly when this is missing.
TEST_MONGODB_URI=mongodb://127.0.0.1:27018/guihua_library_test
